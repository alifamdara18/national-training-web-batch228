---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import coachSuryaImg from '../assets/coach-surya-removebg-preview.png';
import CoachHeroParallax from '../components/react/CoachHeroParallax';
import CoachParallaxSection from '../components/react/CoachParallaxSection';
import VideoGallery from '../components/react/VideoGallery';
import FloatingWhatsAppButton from '../components/react/FloatingVideoWidget';
import PricingCards from '../components/react/PricingCards';
import EmotionalHook from '../components/react/EmotionalHook';
import ReflectionSection from '../components/react/ReflectionSection';
import PhilosophySection from '../components/react/PhilosophySection';
import Methodology from '../components/react/Methodology';
import SelfReflection from '../components/react/SelfReflection';
import FinalCTA from '../components/react/FinalCTA';
import { Play, ShieldCheck, ArrowRight, Star, MessageCircle } from 'lucide-react';
---

<Layout title="Innerpiece Public Speaking Batch 228 - Amdara Training">
  <main class="relative overflow-hidden bg-navy-950 text-slate-100">
    {/* Hero Background */}
    <div class="absolute top-0 left-0 right-0 h-[85vh] bg-gradient-to-b from-navy-900 via-navy-950 to-navy-950 -z-10">
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-transparent to-navy-900/60"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-12 lg:pt-16 lg:pb-16">
      {/* Hero Section: 2 Columns on Desktop, Clean Responsive Stacking on Mobile */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        {/* Left Column: Copywriting, Hook & Action */}
        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 font-medium text-sm backdrop-blur-sm shadow-[0_0_20px_rgba(212,175,55,0.2)] mb-6">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-gold-500"></span>
            </span>
            Pendaftaran Batch 228 Resmi Dibuka (Slot Terbatas)
          </div>
          
          {/* Copywriting Hook & Trigger khusus "kaum mendang-mending" */}
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-black text-white leading-tight tracking-tight drop-shadow-xl mb-6">
            Ngapain Bayar Mahal Kelas Public Speaking Kalau <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-yellow-400 to-gold-500 drop-shadow-[0_0_25px_rgba(212,175,55,0.4)]">Cuma Dapet Teori?</span>
          </h1>

          {/* Coach Surya Visual for Mobile (Displays right after headline on mobile devices) */}
          <div class="block lg:hidden w-full my-6 py-2">
            <CoachHeroParallax client:load>
              <Image 
                src={coachSuryaImg} 
                alt="Coach Surya - Master Public Speaking Amdara Training" 
                width={360}
                height={540}
                loading="eager"
                fetchpriority="high"
                class="w-full max-h-[380px] object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.7)] select-none pointer-events-none"
              />
            </CoachHeroParallax>
          </div>
          
          <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-2xl leading-relaxed mb-6">
            Untuk kamu yang rajin membandingkan benefit & harga: Di Amdara Training, kamu langsung <strong class="text-white">praktik 100%</strong> dengan bimbingan intensif hingga benar-benar siap kuasai panggung tanpa bikin dompet menjerit!
          </p>

          {/* Curiosity Trigger */}
          <div class="w-full max-w-xl bg-navy-900/80 border border-gold-500/30 rounded-2xl p-4 sm:p-5 backdrop-blur-md shadow-[0_0_30px_rgba(0,0,0,0.3)] mb-8 transition-all hover:border-gold-500/60 hover:shadow-[0_0_25px_rgba(212,175,55,0.25)]">
            <a href="#preview-video" class="text-gold-300 hover:text-gold-200 text-sm sm:text-base font-semibold flex items-center justify-center lg:justify-start gap-2 transition-colors">
              💡 <span class="underline decoration-gold-500/50 underline-offset-4">Masih Ragu Bicara di Depan Umum?</span> Intip Dulu Keseruan Latihan Tanpa Biaya di Sini! →
            </a>
          </div>

          {/* Hero CTAs */}
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 w-full max-w-lg mb-8">
            <a 
              href="#pricing" 
              class="w-full sm:w-auto flex-1 flex items-center justify-center gap-2 py-4 px-8 bg-gradient-to-r from-gold-500 via-yellow-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-navy-950 rounded-xl font-black text-lg shadow-[0_0_30px_rgba(212,175,55,0.4)] transition-all hover:scale-105 active:scale-95"
            >
              Kunci Slot Batch 228 <ArrowRight className="w-5 h-5" />
            </a>
            <a 
              href="https://wa.me/6281234567890?text=Halo%20Manajemen%20Amdara%20Training%2C%20saya%20ingin%20konsultasi%20mengenai%20kelas%20Public%20Speaking%20Batch%20228." 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex-1 flex items-center justify-center gap-2 py-4 px-6 bg-emerald-600/90 hover:bg-emerald-500 text-white rounded-xl font-bold text-base border border-emerald-400/30 shadow-lg transition-all hover:scale-105 active:scale-95"
            >
              <MessageCircle className="w-5 h-5" /> Konsultasi WA
            </a>
          </div>

          <div class="flex items-center justify-center lg:justify-start gap-4">
            <div class="flex -space-x-3">
              {[1, 2, 3, 4, 5].map((i) => (
                <img src={`https://i.pravatar.cc/100?img=${i + 10}`} alt="Alumni Amdara" class="w-9 h-9 rounded-full border-2 border-navy-900 shadow-md" />
              ))}
            </div>
            <div class="text-left">
              <div class="flex text-gold-400 drop-shadow-[0_0_5px_rgba(212,175,55,0.5)]">
                {[1, 2, 3, 4, 5].map(() => <Star className="w-4 h-4 fill-current" />)}
              </div>
              <p class="text-xs text-slate-300 font-medium mt-0.5">Dipercaya oleh 2,000+ Alumni & Professional</p>
            </div>
          </div>

        </div>

        {/* Right Column: Coach Surya Parallax Visual on Desktop */}
        <div class="hidden lg:flex lg:col-span-5 justify-center lg:justify-end relative">
          <CoachHeroParallax client:load>
            <Image 
              src={coachSuryaImg} 
              alt="Coach Surya - Master Public Speaking Amdara Training" 
              width={420}
              height={630}
              loading="eager"
              fetchpriority="high"
              class="w-full max-h-[580px] object-contain drop-shadow-[0_20px_35px_rgba(0,0,0,0.7)] select-none pointer-events-none"
            />
          </CoachHeroParallax>
        </div>

      </div>
    </div>

    <EmotionalHook client:load />
    
    <ReflectionSection client:load />

    {/* Video Gallery / Preview Section with 3 YouTube Embeds */}
    <VideoGallery client:load />
    
    <PhilosophySection client:load />
    
    <Methodology client:load />
    
    {/* Dedicated Coach Surya Trainer Profile Section */}
    <CoachParallaxSection client:load>
      <Image 
        src={coachSuryaImg} 
        alt="Coach Surya - Lead Coach Innerpeace Public Speaking" 
        width={408}
        height={612}
        loading="lazy"
        class="w-full max-h-[520px] object-contain drop-shadow-[0_20px_35px_rgba(0,0,0,0.7)] select-none pointer-events-none"
      />
    </CoachParallaxSection>

    <SelfReflection client:load />
      
    {/* Sales/Pricing Section */}
    <section id="pricing" class="mt-8 w-full relative z-10 py-12">
      <PricingCards client:load />
    </section>

    <FinalCTA client:load />

    {/* Footer Direct Conversion */}
    <footer class="border-t border-navy-800 bg-navy-950 py-12 text-center text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-semibold text-slate-300 mb-2">Amdara Training & Consultancy — Batch 228</p>
        <p class="text-xs text-slate-500">Seluruh hak cipta dilindungi. Pertanyaan & Kerjasama: WhatsApp Manajemen Amdara.</p>
      </div>
    </footer>

    {/* Floating WhatsApp Button (React Component) */}
    <FloatingWhatsAppButton client:load />
  </main>
</Layout>

