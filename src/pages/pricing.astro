    {/* Ambient Glow & Starfield Background */}
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-gold-500/15 via-navy-900/50 to-transparent rounded-full blur-3xl pointer-events-none -z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-15 pointer-events-none -z-10"
    >
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      {/* Top Back Navigation Bar */}
      <div
        class="mb-10 flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 hover:text-gold-300 transition-colors group px-4 py-2.5 rounded-2xl bg-navy-900/80 border border-gold-500/30 hover:border-gold-500/60 backdrop-blur-md shadow-lg"
