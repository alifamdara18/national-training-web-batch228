            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 py-3 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm border border-emerald-400/30 shadow-lg transition-all hover:scale-105 active:scale-95"
