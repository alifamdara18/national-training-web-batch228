---
import Layout from "../layouts/Layout.astro";
import PricingCards from "../components/react/PricingCards";
import FloatingWhatsAppButton from "../components/react/FloatingVideoWidget";
import {
  ArrowLeft,
  ShieldCheck,
  Sparkles,
  CheckCircle2,
  MessageCircle,
  Lock,
  Award,
  HeartHandshake,
} from "lucide-react";
