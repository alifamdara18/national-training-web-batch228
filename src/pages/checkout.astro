---
import Layout from '../layouts/Layout.astro';
import CheckoutForm from '../components/react/CheckoutForm';
import { ArrowLeft, ShieldCheck } from 'lucide-react';
---

<Layout title="Checkout - Innerpiece Batch 228">
  <div class="min-h-screen relative py-12 px-4 sm:px-6 lg:px-8 bg-navy-950">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 pointer-events-none mix-blend-overlay"></div>
    
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="mb-8">
        <a href="/" class="inline-flex items-center text-sm font-medium text-slate-400 hover:text-gold-400 transition-colors">
          <ArrowLeft class="w-4 h-4 mr-2" /> Kembali ke Landing Page
        </a>
      </div>

      <div class="text-center mb-10">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Selesaikan Pembayaran Anda</h1>
        <p class="mt-2 text-slate-300">Selangkah lagi menuju transformasi public speaking Anda.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        {/* Order Summary */}
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="bg-navy-800 rounded-3xl p-6 shadow-[0_0_30px_rgba(0,0,0,0.5)] border border-gold-500/30 sticky top-8">
            <h2 class="text-xl font-bold text-white mb-6">Ringkasan Pesanan</h2>
            
            <div class="flex gap-4 items-start pb-6 border-b border-navy-700">
              <div class="w-20 h-20 rounded-xl bg-gold-500/20 border border-gold-500/30 flex items-center justify-center flex-shrink-0 shadow-inner">
                <span class="text-gold-400 font-bold text-xl">IP</span>
              </div>
              <div>
                <h3 class="font-bold text-white leading-tight">Innerpiece Public Speaking</h3>
                <p class="text-sm text-slate-400 mt-1">Batch 228 - Akses Penuh</p>
              </div>
            </div>

            <div class="py-6 space-y-3 border-b border-navy-700">
              <div class="flex justify-between text-slate-300 text-sm">
                <span>Harga Normal</span>
                <span class="line-through decoration-red-500/70">Rp 2.500.000</span>
              </div>
              <div class="flex justify-between text-gold-400 text-sm font-bold">
                <span>Diskon Promo</span>
                <span>- Rp 1.100.000</span>
              </div>
            </div>

            <div class="py-6">
              <div class="flex justify-between items-end">
                <span class="text-white font-bold">Total Tagihan</span>
                <div class="text-right">
                  <div class="text-xs text-slate-400 mb-1">Termasuk Pajak</div>
                  <span class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gold-300 to-gold-500 drop-shadow-[0_0_10px_rgba(212,175,55,0.3)]">Rp 1.400.000</span>
                </div>
              </div>
            </div>

            <div class="mt-4 p-4 rounded-xl bg-navy-900 border border-navy-700 flex items-start gap-3">
              <ShieldCheck class="w-5 h-5 text-gold-400 flex-shrink-0 mt-0.5" />
              <p class="text-xs text-slate-300 leading-relaxed">
                Pembayaran 100% aman dan terenkripsi. Dilengkapi dengan garansi uang kembali 7 hari jika Anda tidak puas dengan materi kami.
              </p>
            </div>
          </div>
        </div>

        {/* Checkout Form */}
        <div class="lg:col-span-7 order-1 lg:order-2">
          <CheckoutForm client:load />
        </div>

      </div>
    </div>
  </div>
</Layout>
