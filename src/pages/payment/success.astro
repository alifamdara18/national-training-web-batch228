---
import Layout from '../../layouts/Layout.astro';
import { getOrderByOrderId, updateOrderStatus, getZoomTicket } from '../../lib/supabase';
import { 
  CheckCircle2, 
  ArrowRight, 
  ShieldCheck, 
  Sparkles, 
  Calendar, 
  User, 
  CreditCard, 
  Mail, 
  Video, 
  BookOpen, 
  Copy, 
  Check, 
  ExternalLink,
  MessageCircle,
  Building2,
  Lock,
  Tag
} from 'lucide-react';

export const prerender = false;

// Ambil parameter dari URL query
const orderId = Astro.url.searchParams.get('order_id') || `SIM-AMD237-${Date.now().toString().slice(-6)}`;
const packageParam = Astro.url.searchParams.get('package') || 'vip';
const nameParam = Astro.url.searchParams.get('name') || 'Peserta Terdaftar';
const amountParam = Astro.url.searchParams.get('gross_amount');

// Query Supabase untuk membaca data pesanan
let order = await getOrderByOrderId(orderId);

// Jika status masih PENDING, perbarui status ke SUCCESS karena sudah berada di success page
if (order && (order.status === 'PENDING' || order.status === 'PENDING_VERIFICATION')) {
  await updateOrderStatus(orderId, 'SUCCESS', {
    metadata: { ...order.metadata, confirmed_via: 'success_page_simulation' }
  });
  order.status = 'SUCCESS';
}

// Data Peserta & Transaksi
const customerName = order?.user_name || nameParam;
const packageType = order?.package_type || packageParam;
const isVip = packageType === 'vip';
const amount = order?.amount || (amountParam ? Number(amountParam) : (isVip ? 1400000 : 49000));
const adSource = order?.metadata?.ad_source || 'Meta Ads (FB/IG)';
const isSimulation = Boolean(order?.metadata?.is_manual_simulation || orderId.startsWith('SIM-'));

const formattedAmount = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0
}).format(amount);

const transactionDate = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

// Ambil Tiket Zoom Resmi dari tabel `zoom_tickets` Supabase (dengan fallback handal)
const zoomTicket = await getZoomTicket();

const dashboardUrl = `/lms/dashboard?order_id=${encodeURIComponent(orderId)}&package=${encodeURIComponent(packageType)}&name=${encodeURIComponent(customerName)}&verified=true`;
---

<Layout title="Pembayaran Terverifikasi - Innerpiece Public Speaking">
  <div class="min-h-screen relative py-12 px-4 sm:px-6 lg:px-8 bg-navy-950 flex flex-col justify-center items-center">
    {/* Background Glow & Pattern */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gold-500/15 via-navy-950 to-navy-950 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 pointer-events-none mix-blend-overlay"></div>

    <div class="max-w-2xl w-full relative z-10 my-auto space-y-8">
      
      {/* 1. Header & Badge Status Simulasi UX */}
      <div class="text-center">
        <div class="relative inline-flex items-center justify-center mb-5">
          <div class="absolute -inset-4 rounded-full bg-emerald-500/25 blur-xl animate-pulse"></div>
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-tr from-emerald-600 via-emerald-500 to-teal-400 p-1 shadow-[0_0_40px_rgba(16,185,129,0.5)] flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-navy-950 flex items-center justify-center">
              <CheckCircle2 class="w-12 h-12 sm:w-14 sm:h-14 text-emerald-400 stroke-[2.5]" />
            </div>
          </div>
        </div>

        {/* Badge Status Wajib Sesuai Spesifikasi */}
        <div class="flex justify-center mb-3">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs sm:text-sm font-extrabold shadow-[0_0_20px_rgba(16,185,129,0.25)]">
            <ShieldCheck class="w-4 h-4 text-emerald-400" />
            Pembayaran Lunas & Terverifikasi (Mode Simulasi UX)
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
          Selamat Bergabung!
        </h1>
        <p class="mt-2 text-slate-300 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed">
          Halo <strong class="text-gold-300 font-bold">{customerName}</strong>, simulasi pembayaran manual transfer BCA telah berhasil dicatat dan hak akses LMS Anda telah aktif 100%.
        </p>
      </div>

      {/* 2. Detail Tiket Zoom (Zoom Tickets Card) */}
      <div class="bg-gradient-to-b from-navy-900 to-navy-950 rounded-3xl p-6 sm:p-7 border-2 border-gold-500/40 shadow-[0_0_40px_rgba(212,175,55,0.15)] relative overflow-hidden">
        {/* Top Glow bar */}
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-gold-500 via-yellow-400 to-gold-600"></div>

        <div class="flex items-center justify-between pb-4 border-b border-navy-800">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-gold-500/20 border border-gold-500/40 flex items-center justify-center text-gold-400">
              <Video class="w-5 h-5" />
            </div>
            <div>
              <h2 class="text-base font-extrabold text-white">Tiket Masuk Live Zoom Eksklusif</h2>
              <p class="text-[11px] text-gold-400 font-medium">Innerpiece Public Speaking</p>
            </div>
          </div>
          <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-gold-500/10 text-gold-300 border border-gold-500/30">
            Official Ticket
          </span>
        </div>

        <div class="py-4 space-y-3.5 text-xs sm:text-sm">
          <div class="bg-navy-950/80 p-3.5 rounded-2xl border border-navy-800">
            <span class="text-[11px] text-slate-400 block mb-0.5">Topik Sesi Pembelajaran:</span>
            <p class="font-bold text-white leading-snug">{zoomTicket.topic}</p>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-gold-300">
              <Calendar class="w-3.5 h-3.5" />
              <span>{zoomTicket.schedule_time}</span>
            </div>
          </div>

          {/* Meeting ID & Passcode Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {/* Meeting ID */}
            <div class="p-3.5 rounded-2xl bg-navy-950/80 border border-navy-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-semibold">Meeting ID:</span>
                <span id="zoom-meeting-id" class="font-mono text-base font-extrabold text-gold-400">
                  {zoomTicket.meeting_id}
                </span>
              </div>
              <button
                type="button"
                id="btn-copy-meeting"
                class="copy-btn p-2 rounded-lg bg-navy-800 hover:bg-gold-500 text-slate-300 hover:text-navy-950 border border-navy-700 transition-all cursor-pointer"
                title="Salin Meeting ID"
                data-text={zoomTicket.meeting_id}
              >
                <Copy class="w-4 h-4 icon-copy" />
              </button>
            </div>

            {/* Passcode */}
            <div class="p-3.5 rounded-2xl bg-navy-950/80 border border-navy-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-semibold">Passcode:</span>
                <span id="zoom-passcode" class="font-mono text-base font-extrabold text-gold-400">
                  {zoomTicket.passcode}
                </span>
              </div>
              <button
                type="button"
                id="btn-copy-passcode"
                class="copy-btn p-2 rounded-lg bg-navy-800 hover:bg-gold-500 text-slate-300 hover:text-navy-950 border border-navy-700 transition-all cursor-pointer"
                title="Salin Passcode"
                data-text={zoomTicket.passcode}
              >
                <Copy class="w-4 h-4 icon-copy" />
              </button>
            </div>
          </div>

          {/* Link Zoom Langsung */}
          <div class="pt-1">
            <a
              href={zoomTicket.zoom_url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-navy-800 hover:bg-navy-700 text-slate-200 hover:text-white font-semibold text-xs border border-gold-500/20 transition-all"
            >
              <span>Buka Tautan Zoom di Browser / Aplikasi</span>
              <ExternalLink class="w-3.5 h-3.5 text-gold-400" />
            </a>
          </div>
        </div>
      </div>

      {/* 3. Transaction Summary Card */}
      <div class="bg-navy-900/90 rounded-3xl p-6 sm:p-7 border border-navy-800 shadow-xl backdrop-blur-md">
        <div class="flex items-center justify-between pb-3.5 border-b border-navy-800">
          <div class="flex items-center gap-2">
            <Sparkles class="w-4 h-4 text-gold-400" />
            <h2 class="text-sm sm:text-base font-bold text-white">Ringkasan Transaksi Pembayaran</h2>
          </div>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[11px] font-extrabold">
            PAID / LUNAS
          </span>
        </div>

        <div class="py-4 space-y-3 text-xs sm:text-sm">
          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-1.5">
              <CreditCard class="w-3.5 h-3.5 text-slate-500" /> Nomor Pesanan (Order ID)
            </span>
            <span class="font-mono font-bold text-gold-300 bg-navy-950 px-2.5 py-1 rounded-lg border border-navy-800 text-xs">
              {orderId}
            </span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-1.5">
              <User class="w-3.5 h-3.5 text-slate-500" /> Nama Peserta
            </span>
            <span class="font-semibold text-slate-200">{customerName}</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-1.5">
              <Building2 class="w-3.5 h-3.5 text-slate-500" /> Metode Pembayaran
            </span>
            <span class="font-medium text-slate-300 text-right">
              Transfer Manual BCA (a.n Sugiyanti)
            </span>
          </div>

          {adSource && (
            <div class="flex justify-between items-center">
              <span class="text-slate-400 flex items-center gap-1.5">
                <Tag class="w-3.5 h-3.5 text-slate-500" /> Sumber Traffic
              </span>
              <span class="text-slate-300 font-medium">{adSource}</span>
            </div>
          )}

          <div class="flex justify-between items-center">
            <span class="text-slate-400">Paket Terpilih</span>
            <span class="font-bold text-white capitalize">
              {isVip ? 'VIP Pendampingan' : 'Paket Mahasiswa / Mandiri'}
            </span>
          </div>

          <div class="pt-3 border-t border-navy-800 flex justify-between items-baseline">
            <span class="text-slate-300 font-semibold">Total Terverifikasi</span>
            <span class="text-xl sm:text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gold-300 to-gold-500">
              {formattedAmount}
            </span>
          </div>
        </div>

        {/* Feature Highlights */}
        <div class="mt-2 pt-3 border-t border-navy-800/80 bg-navy-950/60 rounded-2xl p-3.5">
          <h3 class="text-[11px] font-bold text-gold-400 mb-2 uppercase tracking-wider">Akses Yang Diaktifkan:</h3>
          <ul class="space-y-1.5 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <BookOpen class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" />
              <span>Akses Penuh Semua Modul & Video LMS Innerpiece Public Speaking</span>
            </li>
            <li class="flex items-center gap-2">
              <Video class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" />
              <span>Tiket Resmi Sesi Interaktif bersama Master Surya Jaya Negara</span>
            </li>
            <li class="flex items-center gap-2">
              <Mail class="w-3.5 h-3.5 text-gold-400 flex-shrink-0" />
              <span>Konfirmasi data pendaftaran otomatis tersimpan di database</span>
            </li>
          </ul>
        </div>
      </div>

      {/* 4. Tombol CTA Utama Wajib Sesuai Spesifikasi */}
      <div class="space-y-3.5 text-center">
        <a
          href={dashboardUrl}
          id="btn-lms-dashboard"
          class="w-full flex items-center justify-center gap-3 py-4 sm:py-4.5 px-8 bg-gradient-to-r from-gold-500 via-yellow-400 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-navy-950 rounded-2xl font-extrabold text-base sm:text-lg shadow-[0_0_30px_rgba(212,175,55,0.4)] transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] group cursor-pointer"
        >
          <span>🚀 Gabung Sesi Zoom / Masuk Dashboard LMS</span>
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1.5 transition-transform" />
        </a>

        {/* Bantuan WhatsApp Admin */}
        <div class="flex items-center justify-center gap-4 text-xs text-slate-400">
          <a
            href="https://wa.me/6281378777838?text=Halo%20Admin%20Amdara%2C%20saya%20sudah%20menyelesaikan%20pembayaran%20dengan%20Order%20ID%20"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-semibold"
          >
            <MessageCircle class="w-4 h-4" /> Butuh Bantuan Admin? Hubungi WA (081378777838)
          </a>
          <span>•</span>
          <a
            href="/"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Kembali ke Beranda
          </a>
        </div>
      </div>

    </div>
  </div>

  {/* Client-side Script untuk One-Click Copy Tiket Zoom */}
  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text');
        if (text && navigator.clipboard) {
          navigator.clipboard.writeText(text);
          btn.classList.add('bg-emerald-500', 'text-navy-950');
          setTimeout(() => {
            btn.classList.remove('bg-emerald-500', 'text-navy-950');
          }, 2000);
        }
      });
    });
  </script>
</Layout>
