# ==============================================================================
# AMBITIOUS AMBITIONS / AMDARA BATCH 228 - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan Client Key & Server Key dari Midtrans Dashboard:
# Sandbox: https://dashboard.sandbox.midtrans.com/settings/access_keys
# Production: https://dashboard.midtrans.com/settings/access_keys

# Client Key (wajib diawali 'PUBLIC_' agar dapat diakses di sisi client/browser Astro)
PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_here

# Server Key (RAHASIA: hanya diakses di sisi server/API endpoint Astro)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key_here

# Mode Midtrans: 'false' untuk Sandbox (Testing), 'true' untuk Production
PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan URL & Anon Key dari Supabase Dashboard:
# Project Settings > API > Project URL & Project API Keys

PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# (Opsional) Service Role Key untuk bypass RLS pada webhook backend Supabase
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
