---
import Layout from '../../layouts/Layout.astro';
import { getOrderByOrderId, updateOrderStatus } from '../../lib/supabase';
import { 
  CheckCircle2, 
  ArrowRight, 
  ShieldCheck, 
  Sparkles, 
  Calendar, 
  User, 
  CreditCard, 
  Mail, 
  ExternalLink,
  Video,
  BookOpen
} from 'lucide-react';

export const prerender = false;

// Ambil parameter dari URL query
const orderId = Astro.url.searchParams.get('order_id') || `AMD228-${Date.now().toString().slice(-6)}`;
const packageParam = Astro.url.searchParams.get('package') || 'vip';
const nameParam = Astro.url.searchParams.get('name') || 'Peserta Terdaftar';
const amountParam = Astro.url.searchParams.get('gross_amount');

// Cek database Supabase untuk data pesanan real
let order = await getOrderByOrderId(orderId);

// Jika pesanan ada dan statusnya masih PENDING, perbarui ke SUCCESS karena user berada di success page
if (order && order.status === 'PENDING') {
  await updateOrderStatus(orderId, 'SUCCESS', {
    metadata: { confirmed_via: 'success_redirect_page' }
  });
  order.status = 'SUCCESS';
}

const customerName = order?.user_name || nameParam;
const packageType = order?.package_type || packageParam;
const isVip = packageType === 'vip';
const amount = order?.amount || (amountParam ? Number(amountParam) : (isVip ? 1400000 : 49000));

const formattedAmount = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0
}).format(amount);

const transactionDate = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});

const dashboardUrl = `/lms/dashboard?order_id=${encodeURIComponent(orderId)}&package=${encodeURIComponent(packageType)}&name=${encodeURIComponent(customerName)}&verified=true`;
---

<Layout title="Pembayaran Berhasil - Innerpiece Batch 228">
  <div class="min-h-screen relative py-12 px-4 sm:px-6 lg:px-8 bg-navy-950 flex flex-col justify-center items-center">
    {/* Subtle Background Glow & Pattern */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gold-500/10 via-navy-950 to-navy-950 pointer-events-none"></div>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 pointer-events-none mix-blend-overlay"></div>

    <div class="max-w-2xl w-full relative z-10 my-auto">
      
      {/* Success Animation & Header */}
      <div class="text-center mb-8">
        <div class="relative inline-flex items-center justify-center mb-6">
          {/* Animated Glowing Rings */}
          <div class="absolute -inset-4 rounded-full bg-emerald-500/20 blur-xl animate-pulse"></div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-emerald-600 via-emerald-500 to-teal-400 p-1 shadow-[0_0_50px_rgba(16,185,129,0.5)] flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-navy-950 flex items-center justify-center">
              <CheckCircle2 class="w-14 h-14 text-emerald-400 stroke-[2.5] animate-in zoom-in duration-300" />
            </div>
          </div>
        </div>

        <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold mb-3 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
          <ShieldCheck class="w-4 h-4" /> Transaksi Berhasil & Terenkripsi
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Pembayaran Lunas & Terverifikasi!
        </h1>
        <p class="mt-3 text-slate-300 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
          Selamat <span class="text-gold-300 font-semibold">{customerName}</span>, akses keanggotaan Anda di <strong class="text-white">Innerpiece Public Speaking Batch 228</strong> telah resmi aktif.
        </p>
      </div>

      {/* Transaction Summary Card */}
      <div class="bg-navy-900/90 rounded-3xl p-6 sm:p-8 border border-gold-500/30 shadow-[0_0_40px_rgba(0,0,0,0.7)] backdrop-blur-md mb-8">
        <div class="flex items-center justify-between pb-4 border-b border-navy-800">
          <div class="flex items-center gap-2">
            <Sparkles class="w-5 h-5 text-gold-400" />
            <h2 class="text-base font-bold text-white">Detail Transaksi Pembayaran</h2>
          </div>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-extrabold">
            PAID / LUNAS
          </span>
        </div>

        <div class="py-5 space-y-3.5 text-sm">
          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-2">
              <CreditCard class="w-4 h-4 text-slate-500" /> Nomor Pesanan (Order ID)
            </span>
            <span class="font-mono font-bold text-gold-300 bg-navy-950 px-2.5 py-1 rounded-lg border border-navy-800 text-xs sm:text-sm">
              {orderId}
            </span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-2">
              <User class="w-4 h-4 text-slate-500" /> Nama Peserta
            </span>
            <span class="font-semibold text-slate-200">{customerName}</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400 flex items-center gap-2">
              <Calendar class="w-4 h-4 text-slate-500" /> Waktu Transaksi
            </span>
            <span class="text-slate-300">{transactionDate} WIB</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400">Paket Terpilih</span>
            <span class="font-bold text-white capitalize">
              {isVip ? 'VIP Pendampingan (Batch 228)' : 'Paket Mahasiswa / Mandiri'}
            </span>
          </div>

          <div class="pt-3 border-t border-navy-800 flex justify-between items-baseline">
            <span class="text-slate-300 font-semibold">Total Dibayar</span>
            <span class="text-xl sm:text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gold-300 to-gold-500 drop-shadow-[0_0_10px_rgba(212,175,55,0.3)]">
              {formattedAmount}
            </span>
          </div>
        </div>

        {/* Feature Highlights Based on Plan */}
        <div class="mt-4 pt-4 border-t border-navy-800/80 bg-navy-950/60 rounded-2xl p-4">
          <h3 class="text-xs font-bold text-gold-400 mb-2 uppercase tracking-wider">Hak Akses Yang Telah Diaktifkan:</h3>
          <ul class="space-y-2 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <BookOpen class="w-4 h-4 text-gold-400 flex-shrink-0" />
              <span>Akses Penuh Seluruh Modul & Video LMS Innerpiece</span>
            </li>
            {isVip && (
              <li class="flex items-center gap-2">
                <Video class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span>Tiket Live Zoom Eksklusif Hari Minggu 19:00 WIB</span>
              </li>
            )}
            <li class="flex items-center gap-2">
              <Mail class="w-4 h-4 text-gold-400 flex-shrink-0" />
              <span>Kuitansi & petunjuk akses resmi telah dikirim ke email</span>
            </li>
          </ul>
        </div>
      </div>

      {/* Main Action Buttons */}
      <div class="space-y-4 text-center">
        <a
          href={dashboardUrl}
          id="btn-lms-dashboard"
          class="w-full flex items-center justify-center gap-3 py-4 sm:py-4.5 px-8 bg-gradient-to-r from-gold-500 via-yellow-400 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-navy-950 rounded-2xl font-extrabold text-lg shadow-[0_0_30px_rgba(212,175,55,0.4)] transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] group"
        >
          <span>🚀 Masuk ke Dashboard LMS Saya</span>
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1.5 transition-transform" />
        </a>

        {/* Auto Redirect Info */}
        <p id="countdown-text" class="text-xs text-slate-400">
          Anda akan diarahkan otomatis ke dashboard dalam <span id="countdown-number" class="text-gold-400 font-bold">8</span> detik...
        </p>

        <div class="pt-2">
          <a
            href="/"
            class="text-xs text-slate-500 hover:text-slate-300 transition-colors"
          >
            Kembali ke Beranda Amdara
          </a>
        </div>
      </div>

    </div>
  </div>

  {/* Client-side Auto-redirect Script */}
  <script define:vars={{ targetUrl: dashboardUrl }}>
    let timeLeft = 8;
    const countdownEl = document.getElementById('countdown-number');
    
    const timer = setInterval(() => {
      timeLeft -= 1;
      if (countdownEl) {
        countdownEl.innerText = String(timeLeft);
      }
      if (timeLeft <= 0) {
        clearInterval(timer);
        window.location.href = targetUrl;
      }
    }, 1000);
  </script>
</Layout>
