---
import Layout from '../layouts/Layout.astro';
import CheckoutForm from '../components/react/CheckoutForm';
import { ArrowLeft, ShieldCheck, CheckCircle2, Lock } from 'lucide-react';

const planParam = Astro.url.searchParams.get('plan') || 'mahasiswa';
const durationParam = Astro.url.searchParams.get('duration') || '3bulan';

const isVip = planParam === 'vip';
const is1Tahun = durationParam === '1tahun';

const planTitle = isVip ? 'Paket VIP Pendampingan' : 'Paket Mahasiswa / Mandiri';
const planSubtitle = isVip 
  ? `Batch 228 - Live Zoom Interaktif & Mentoring (${is1Tahun ? '1 Tahun' : '3 Bulan'})` 
  : 'Batch 228 - Akses Modul Self-Paced Praktis Tanpa Zoom';

const normalPrice = isVip 
  ? (is1Tahun ? 'Rp 5.000.000' : 'Rp 2.500.000') 
  : 'Rp 250.000';

const promoDiscount = isVip 
  ? (is1Tahun ? '- Rp 2.200.000' : '- Rp 1.100.000') 
  : '- Rp 201.000';

const finalPrice = isVip 
  ? (is1Tahun ? 'Rp 2.800.000' : 'Rp 1.400.000') 
  : 'Rp 49.000';
---

<Layout title="Checkout Pembayaran - Innerpiece Batch 228">
  <div class="min-h-screen relative py-12 px-4 sm:px-6 lg:px-8 bg-navy-950">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 pointer-events-none mix-blend-overlay"></div>
    
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="mb-8 flex items-center justify-between">
        <a href="/" class="inline-flex items-center text-sm font-semibold text-slate-400 hover:text-gold-400 transition-colors">
          <ArrowLeft class="w-4 h-4 mr-2" /> Kembali ke Landing Page
        </a>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-900 border border-gold-500/20 text-gold-400 text-xs font-semibold shadow-sm">
          <Lock class="w-3.5 h-3.5" /> 256-Bit SSL Encrypted
        </div>
      </div>

      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Selesaikan Pembayaran Anda</h1>
        <p class="mt-2 text-slate-300 max-w-xl mx-auto text-sm sm:text-base">
          Selangkah lagi menuju transformasi keberanian dan teknik public speaking terbaik Anda bersama Coach Surya.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        {/* Order Summary Sidebar */}
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="bg-navy-800/90 rounded-3xl p-6 sm:p-7 shadow-[0_0_35px_rgba(0,0,0,0.6)] border border-gold-500/30 sticky top-8 backdrop-blur-md">
            <h2 class="text-xl font-bold text-white mb-6 flex items-center justify-between">
              <span>Ringkasan Pesanan</span>
              <span class="text-xs font-normal text-gold-400 bg-gold-500/10 px-2.5 py-1 rounded-full border border-gold-500/20">
                Resmi Amdara
              </span>
            </h2>
            
            <div class="flex gap-4 items-start pb-6 border-b border-navy-700/80">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-gold-500/20 to-gold-600/30 border border-gold-500/40 flex items-center justify-center flex-shrink-0 shadow-inner">
                <span class="text-gold-400 font-extrabold text-xl tracking-wider">IP</span>
              </div>
              <div>
                <h3 class="font-bold text-white leading-tight text-base">{planTitle}</h3>
                <p class="text-xs text-slate-400 mt-1">{planSubtitle}</p>
              </div>
            </div>

            <div class="py-5 space-y-3 border-b border-navy-700/80">
              <div class="flex justify-between text-slate-400 text-sm">
                <span>Harga Normal</span>
                <span class="line-through decoration-red-500/70">{normalPrice}</span>
              </div>
              <div class="flex justify-between text-emerald-400 text-sm font-semibold">
                <span>Diskon Eksklusif Batch 228</span>
                <span>{promoDiscount}</span>
              </div>
            </div>

            <div class="py-5 border-b border-navy-700/80">
              <div class="flex justify-between items-end">
                <div>
                  <span class="text-white font-bold text-base block">Total Tagihan</span>
                  <span class="text-[11px] text-slate-400">Sudah termasuk PPN & Biaya Gateway</span>
                </div>
                <div class="text-right">
                  <span class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gold-300 to-gold-500 drop-shadow-[0_0_15px_rgba(212,175,55,0.3)]">
                    {finalPrice}
                  </span>
                </div>
              </div>
            </div>

            {/* Keuntungan Tambahan */}
            <div class="py-4 space-y-2.5 text-xs text-slate-300">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-gold-400 flex-shrink-0" />
                <span>Aktivasi Akun LMS Instan setelah verifikasi</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-gold-400 flex-shrink-0" />
                <span>Akses grup WhatsApp eksklusif peserta</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-gold-400 flex-shrink-0" />
                <span>Sertifikat Digital Resmi Terverifikasi</span>
              </div>
            </div>

            <div class="mt-2 p-4 rounded-2xl bg-navy-950/80 border border-navy-700 flex items-start gap-3">
              <ShieldCheck class="w-5 h-5 text-gold-400 flex-shrink-0 mt-0.5" />
              <p class="text-xs text-slate-300 leading-relaxed">
                Pembayaran 100% aman terintegrasi Midtrans. Didukung Garansi Kepuasan Pelatihan 7 Hari.
              </p>
            </div>
          </div>
        </div>

        {/* Checkout Form Component */}
        <div class="lg:col-span-7 order-1 lg:order-2">
          <CheckoutForm 
            client:load 
            initialPackage={isVip ? 'vip' : 'mahasiswa'} 
            initialDuration={is1Tahun ? '1tahun' : '3bulan'} 
          />
        </div>

      </div>
    </div>
  </div>
</Layout>
